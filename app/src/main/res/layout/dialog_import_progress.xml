<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hub_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在导入游戏"
        android:textColor="@color/hub_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="游戏包较大时需要几分钟，请保持在这个页面"
        android:textColor="@color/hub_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/imported"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/hub_accent"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="1234" />

        <TextView
            android:id="@+id/percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hub_text"
            android:textSize="16sp"
            tools:text="37%" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="款游戏已导入"
        android:textColor="@color/hub_text_secondary"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressTint="@color/hub_accent"
        android:indeterminateTint="@color/hub_accent" />

    <TextView
        android:id="@+id/current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hub_text_secondary"
        android:textSize="12.5sp"
        tools:text="正在识别：七侠五义" />

    <TextView
        android:id="@+id/skipped"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/hub_text_secondary"
        android:textSize="12.5sp"
        tools:text="跳过重复 12 个 · 无效 1 个" />

    <TextView
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:background="?android:selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="取消"
        android:textColor="@color/hub_accent"
        android:textSize="15sp" />
</LinearLayout>
