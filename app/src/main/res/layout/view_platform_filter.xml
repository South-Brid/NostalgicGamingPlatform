<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_hub_segment"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/chip_java"
        style="@style/HubSegment">

        <TextView
            android:id="@+id/chip_java_title"
            style="@style/HubSegmentTitle"
            android:text="☕ Java 游戏厅" />

        <TextView
            android:id="@+id/chip_java_count"
            style="@style/HubSegmentCount" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chip_mrp"
        style="@style/HubSegment"
        android:layout_marginStart="4dp">

        <TextView
            android:id="@+id/chip_mrp_title"
            style="@style/HubSegmentTitle"
            android:text="🎮 MRP 游戏厅" />

        <TextView
            android:id="@+id/chip_mrp_count"
            style="@style/HubSegmentCount" />
    </LinearLayout>
</LinearLayout>
