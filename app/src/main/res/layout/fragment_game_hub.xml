<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hub_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="怀旧游戏厅"
                        android:textColor="@color/hub_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/hub_text_secondary"
                        android:textSize="12.5sp"
                        tools:text="475 款经典 Java 手机游戏" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/home_add"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_hub_round_button"
                    android:contentDescription="添加游戏"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_hub_folder"
                    android:tint="@color/hub_text" />
            </LinearLayout>

            <include
                android:id="@+id/filter_home"
                layout="@layout/view_platform_filter" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="16dp" />

                <LinearLayout
                    android:id="@+id/home_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="24dp"
                    android:background="@drawable/bg_hub_dialog"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮"
                        android:textSize="56sp" />

                    <TextView
                        android:id="@+id/home_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="游戏厅还是空的"
                        android:textColor="@color/hub_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="把游戏包（zip）拷到手机里，点下面的按钮选择它，\n游戏会自动识别、分类、放进游戏厅。\n支持 Java（jar）和 MRP（mrp）游戏，可以多选。"
                        android:textColor="@color/hub_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/home_import"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_hub_pill"
                        android:gravity="center"
                        android:text="导入游戏包"
                        android:textColor="@color/hub_on_accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/HubPageTitle"
                android:text="分类" />

            <include
                android:id="@+id/filter_category"
                layout="@layout/view_platform_filter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ScrollView
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@color/hub_surface"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/side_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/category_list"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingHorizontal="6dp"
                    android:paddingBottom="16dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_hub_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_hub_search" />

                <EditText
                    android:id="@+id/search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索游戏名或拼音首字母，如 qxwy"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/hub_text"
                    android:textColorHint="@color/hub_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/clear"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="清除"
                    android:padding="4dp"
                    android:src="@drawable/ic_hub_close"
                    android:visibility="gone" />
            </LinearLayout>

            <include
                android:id="@+id/filter_search"
                layout="@layout/view_platform_filter" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="16dp" />

                <LinearLayout
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="96dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕹"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="没有找到相关游戏"
                        android:textColor="@color/hub_text"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="试试换个关键词，或者输入拼音首字母"
                        android:textColor="@color/hub_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_mine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/HubPageTitle"
                android:text="我的" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mine_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hub_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/hub_surface"
        android:orientation="horizontal">

        <include
            android:id="@+id/nav_home"
            layout="@layout/item_hub_nav" />

        <include
            android:id="@+id/nav_category"
            layout="@layout/item_hub_nav" />

        <include
            android:id="@+id/nav_search"
            layout="@layout/item_hub_nav" />

        <include
            android:id="@+id/nav_mine"
            layout="@layout/item_hub_nav" />
    </LinearLayout>
</LinearLayout>
